        "figma": "Medium-font-size",
        "purpose": "Text blocks",
        "size": "sm",
        "lineHeight": "relaxed",
        "weight": "extralight",
        "axes": "default",
        "use": "Intro paragraph under a section heading, short standalone text, chips, form fields"
      },
      "caption": {
        "figma": "Small-font-size",
        "purpose": "Small text, descriptions",
        "size": "xs",
        "lineHeight": "normal",
        "weight": "light",
        "axes": "default",
        "use": "Roles, meta, helper and error text, legal notes"
      },
      "link": {
        "figma": "CTA & Nav",
        "purpose": "Buttons, links and special",
        "size": "sm",
        "lineHeight": "relaxed",
        "weight": "light",
        "axes": "default",
        "use": "Header nav, footer links, inline and standalone links"
      },
      "button": {
        "figma": "Button",
        "purpose": "Buttons, especially in forms",
        "size": "md",
        "lineHeight": "relaxed",
        "weight": "light",
        "axes": "default",
        "use": "Button labels"
      }
