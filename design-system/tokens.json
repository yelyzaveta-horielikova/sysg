    "semantic": {
      "$note": "The only text styles allowed. Components reference these names. 'axes: default' means the Fonts table lists no variable axes for the style; the code uses the font defaults (CRSV 0, SHRP 0). 'level' is the heading level implied by the Figma style name. Exception: off-scale text sizes used on the live website are hard-coded in the components that use them (system.md → Typography).",
      "display": {
        "figma": "Heading-1",
        "purpose": "Strong statement or heading",
        "size": "display",
        "lineHeight": "tight",
        "weight": "thin",
        "axes": [
          "crsv-on",
          "shrp-strong"
        ],
        "level": "h1",
        "use": "Hero headline, big numbers (stats, open-source count)"
      },
      "section-title": {
        "figma": "Heading-2",
        "purpose": "Section name (badge)",
        "size": "xl",
        "lineHeight": "normal",
        "weight": "semibold",
        "axes": [
          "crsv-on",
          "shrp-max"
        ],
        "level": "h2",
        "use": "Block heading in the Section heading component"
      },
      "subsection-title": {
        "figma": "Heading-3",
        "purpose": "Smaller section name",
        "size": "lg",
        "lineHeight": "normal",
        "weight": "book",
        "axes": [
          "crsv-on",
          "shrp-soft"
        ],
        "level": "h3",
        "use": "Card titles, FAQ questions, TOC title, step titles, column titles"
      },
      "statement": {
        "figma": "Heading-4",
        "purpose": "Statements, text block name",
        "size": "2xl",
        "lineHeight": "snug",
        "weight": "extralight",
        "axes": [
          "crsv-on",
          "shrp-soft"
        ],
        "level": "h4",
        "use": "CTA card statement, form heading"
      },
      "body-article": {
        "figma": "Large-font-size (text)",
        "purpose": "Article text",
        "size": "sm",
        "lineHeight": "loose",
        "weight": "extralight",
        "axes": [
          "crsv-on",
          "shrp-soft"
        ],
        "use": "Running copy: card bodies, list items, answers, long-form article text",
        "highlight": {
          "weight": "semibold",
          "note": "Fonts table: 'Highlighted text' = 600 inside article text"
        }
      },
      "body-accent": {
        "figma": "Large-font-size-strong",
